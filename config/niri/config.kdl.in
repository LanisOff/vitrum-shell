// vitrum — niri configuration.
//
// Generated by the installer from config/niri/config.kdl.in and rewritten on
// every install. Do not edit it: put your changes in overrides.kdl next to this
// file — it is included last, so anything there wins, and the installer never
// touches it. Keybinds come from KEYBINDS.md (generated/binds.kdl); colours,
// materials and motion from vitrum-theme (generated/look, effects, animations).

// ---------------------------------------------------------------- input -----

input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle,compose:ralt"
        }
        repeat-delay 400
        repeat-rate 35
        numlock
    }

    touchpad {
        tap
        dwt
        natural-scroll
        accel-profile "adaptive"
        accel-speed 0.25
        scroll-method "two-finger"
        click-method "clickfinger"
    }

    mouse {
        accel-profile "flat"
        accel-speed 0.0
    }

    focus-follows-mouse max-scroll-amount="0%"
    warp-mouse-to-focus mode="center-xy-always"
    workspace-auto-back-and-forth
}

// --------------------------------------------------------------- layout -----
//
// Sizes and colours here are defaults; vitrum-theme writes the ones derived
// from your settings (gaps, radii, focus treatment) into generated/look.kdl.

layout {
    gaps 14
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    preset-window-heights {
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // Focus is carried by shadow depth and by dimming unfocused windows
    // (window rules below); a ring is an option in settings.
    border { off; }
    focus-ring { off; }

    shadow {
        on
        softness 40
        spread 2
        offset x=0 y=8
        color "#00000055"
        draw-behind-window false
    }

    tab-indicator {
        hide-when-single-tab
        place-within-column
        gap 6
        width 4
        length total-proportion=0.35
        position "left"
        corner-radius 2
    }
}

// ------------------------------------------------------------- overview -----

overview {
    zoom 0.45
    backdrop-color "#0b0d12"
    workspace-shadow {
        on
        softness 50
        spread 6
        offset x=0 y=14
        color "#00000080"
    }
}

// ----------------------------------------------------------- animations -----
//
// Springs for movement, a short curve for closing. vitrum-theme replaces these
// with the motion tokens the shell uses, so windows and panels share a rhythm.

animations {
    window-open { spring damping-ratio=0.88 stiffness=700 epsilon=0.0001; }
    window-close { duration-ms 140; curve "ease-out-quad"; }
    window-movement { spring damping-ratio=1.0 stiffness=850 epsilon=0.0001; }
    window-resize { spring damping-ratio=1.0 stiffness=900 epsilon=0.0001; }
    horizontal-view-movement { spring damping-ratio=1.0 stiffness=760 epsilon=0.0001; }
    workspace-switch { spring damping-ratio=1.0 stiffness=780 epsilon=0.0001; }
    overview-open-close { spring damping-ratio=0.92 stiffness=680 epsilon=0.0001; }
}

// ------------------------------------------------------------ behaviour -----

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 24
    hide-when-typing
    hide-after-inactive-ms 4000
}

// DISPLAY is niri's: it runs xwayland-satellite for X11 apps (Steam) and sets it.
environment {
    QT_QPA_PLATFORM "wayland"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // niri --session resets this to "niri"; vitrum's own name stays in the list.
    XDG_CURRENT_DESKTOP "niri"
    VITRUM "1"
}

// No hot corners: the shell has none, and niri's own is turned off with them.
gestures {
    hot-corners {
        off
    }
}

// =========================================================== window rules ===

// Unfocused windows recede a little; the focused one keeps full presence.
window-rule {
    match is-focused=false
    opacity 0.92
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// vitrum's own applications: floating, centred near the top.
window-rule {
    match app-id=r#"^vitrum-(settings|disks|about)$"#
    open-floating true
    default-floating-position x=0 y=0 relative-to="top"
    geometry-corner-radius 20
}

window-rule {
    match app-id=r#"^vitrum-settings$"#
    default-column-width { fixed 980; }
    min-width 720
    min-height 560
}

// Media: never dimmed or tinted while you watch.
window-rule {
    match app-id=r#"^(mpv|vlc|org\.gnome\.Loupe|imv|com\.obsproject\.Studio)$"#
    opacity 1.0
}

window-rule {
    match is-floating=true
    geometry-corner-radius 20
    shadow {
        on
        softness 60
        spread 4
        offset x=0 y=18
        color "#00000075"
    }
}

window-rule {
    match app-id=r#"^(pavucontrol|nm-connection-editor|blueman-manager|system-config-printer)$"#
    open-floating true
}

window-rule {
    match title=r#"^(Picture-in-Picture|Picture in picture)$"#
    open-floating true
    default-floating-position x=24 y=24 relative-to="bottom-right"
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}

// Never leak a password manager into a screencast.
window-rule {
    match app-id=r#"^(org\.keepassxc\.KeePassXC|Bitwarden|1Password)$"#
    block-out-from "screencast"
}

window-rule {
    match is-window-cast-target=true
    shadow {
        on
        color "#ff453a99"
    }
}

// ============================================================== includes ===
//
// Order matters: later files win. overrides.kdl is yours and comes last.

include "generated/session.kdl"
include "generated/binds.kdl"
include optional=true "generated/look.kdl"
include optional=true "generated/effects.kdl"
include optional=true "generated/animations.kdl"
include optional=true "displays.kdl"     // written by Settings → Displays
include optional=true "overrides.kdl"
