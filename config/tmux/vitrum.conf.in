# ============================================================================
#  vitrum — the tmux theme (written by vitrum-theme; do not edit)
# ============================================================================
#
#  Sourced by tmux.conf. Rendered from vitrum.conf.in by vitrum-theme:
#
#      an @-delimited NAME   a colour, from ~/.config/vitrum/settings.json
#      \uXXXX    a Nerd Font glyph
#
#  Icons are written as escapes on purpose. Private Use Area characters do not
#  survive being copied through most tools, and an escape with the glyph's
#  name beside it is something you can read without the font installed.
#
#  Regenerate after changing the accent or the appearance:
#      vitrum-theme
#
#  The shape language is the desktop's: floating rounded pills on a
#  transparent bar, so the terminal's own glass shows through between them.
#  The caps are  and  — Nerd Font's half circles.
# ============================================================================

# ----------------------------------------------------------- palette --------
#
# Published as tmux user options so the status scripts can ask tmux for a
# colour instead of each carrying its own copy of the palette.

set -g @vitrum_bg        "@BG@"
set -g @vitrum_bg_elev   "@BG_ELEV@"
set -g @vitrum_pill      "@PILL@"
set -g @vitrum_pill_alt  "@PILL_ALT@"
set -g @vitrum_line      "@LINE@"
set -g @vitrum_fg        "@FG@"
set -g @vitrum_fg2       "@FG2@"
set -g @vitrum_dim       "@DIM@"
set -g @vitrum_accent    "@ACCENT@"
set -g @vitrum_on_accent "@ON_ACCENT@"
set -g @vitrum_red       "@RED@"
set -g @vitrum_orange    "@ORANGE@"
set -g @vitrum_yellow    "@YELLOW@"
set -g @vitrum_green     "@GREEN@"
set -g @vitrum_teal      "@TEAL@"
set -g @vitrum_purple    "@PURPLE@"
set -g @vitrum_pink      "@PINK@"

# ----------------------------------------------------------- transparency ---
#
# tmux must not paint a background of its own.
#
# The compositor refracts the wallpaper behind the terminal and kitty keeps its
# own background translucent, but tmux draws over the entire window — so if a
# pane has a background colour, that is all you see, and the glass underneath
# is wasted. `bg=default` means "whatever the terminal is", which is the
# translucent one. This is why the status bar below sets bg=default between
# every pill as well.
set -g window-style        "bg=default"
set -g window-active-style "bg=default"

# ------------------------------------------------------------- the bar ------

set -g status on
set -g status-position bottom
set -g status-justify absolute-centre
set -g status-style "fg=@FG@,bg=default"
set -g status-left-length 60
set -g status-right-length 220

# ------------------------------------------------------------ session -------
#
#  the session — the anchor pill, always present, always the accent colour.

set -g status-left "#[fg=@ACCENT@,bg=default]#[fg=@ON_ACCENT@,bg=@ACCENT@,bold]   #S#[fg=@ACCENT@,bg=default] "

# ------------------------------------------------------------- windows ------
#
#   #I  index
#   #W  name — tmux-nerd-font-window-name puts the language icon in here
#
# Flags get a glyph rather than tmux's punctuation:
#    zoomed    bell    marked    activity

set -g window-status-separator ""

set -g window-status-format "#[fg=@PILL@,bg=default]#[fg=@DIM@,bg=@PILL@]#I #[fg=@FG2@,bg=@PILL@]#W#{?window_zoomed_flag, ,}#{?window_bell_flag,#[fg=@RED@] ,}#{?window_activity_flag,#[fg=@YELLOW@] ,}#[fg=@PILL@,bg=default] "

set -g window-status-current-format "#[fg=@ACCENT@,bg=default]#[fg=@ON_ACCENT@,bg=@ACCENT@,bold]#I #W#{?window_zoomed_flag, ,}#{?window_marked_flag, ,}#[fg=@ACCENT@,bg=default] "

set -g window-status-bell-style "fg=@RED@,bg=default"
set -g window-status-activity-style "fg=@YELLOW@,bg=default"

# ---------------------------------------------------------------- right -----
#
# Read right to left: what tmux is doing, where you are, what
# the machine is doing, what time it is.
#
#    calendar    clock

set -g status-right "#{prefix_highlight}#(@CONFIG_HOME@/tmux/scripts/git.sh '#{pane_current_path}')#(@CONFIG_HOME@/tmux/scripts/battery.sh)#[fg=@PILL_ALT@,bg=default]#[fg=@DIM@,bg=@PILL_ALT@]  %a %d #[fg=@FG@,bg=@PILL_ALT@] %H:%M #[fg=@PILL_ALT@,bg=default]"

# The prefix / copy / sync indicator, drawn as a pill like everything else.
#    keyboard    copy    sync
set -g @prefix_highlight_prefix_prompt ""
set -g @prefix_highlight_copy_prompt ""
set -g @prefix_highlight_sync_prompt ""
set -g @prefix_highlight_fg "@ON_ORANGE@"
set -g @prefix_highlight_bg "@ORANGE@"
set -g @prefix_highlight_output_prefix "#[fg=@ORANGE@,bg=default]#[fg=@ON_ORANGE@,bg=@ORANGE@,bold] "
set -g @prefix_highlight_output_suffix " #[fg=@ORANGE@,bg=default] "
set -g @prefix_highlight_copy_mode_attr "fg=@ON_GREEN@,bg=@GREEN@,bold"
set -g @prefix_highlight_sync_mode_attr "fg=@ON_RED@,bg=@RED@,bold"

# ---------------------------------------------------------------- panes -----
#
# Hairline borders. The focused pane gets the accent, everything else gets the
# same separator grey the desktop uses between list rows.

set -g pane-border-style "fg=@LINE@,bg=default"
set -g pane-active-border-style "fg=@ACCENT@,bg=default"
set -g pane-border-lines single
set -g pane-border-status off
set -g display-panes-colour "@DIM@"
set -g display-panes-active-colour "@ACCENT@"

# --------------------------------------------------------- messages etc -----

set -g message-style "fg=@ON_ACCENT@,bg=@ACCENT@,bold"
set -g message-command-style "fg=@FG@,bg=@PILL_ALT@"
set -g mode-style "fg=@ON_ACCENT@,bg=@ACCENT@"
set -g copy-mode-match-style "fg=@BG@,bg=@YELLOW@"
set -g copy-mode-current-match-style "fg=@BG@,bg=@ORANGE@"
set -g clock-mode-colour "@ACCENT@"
set -g clock-mode-style 24

# ---------------------------------------------------------- newer tmux ------
#
# Popups and menus only learned to be styled in 3.3, and to have rounded
# corners in 3.4. Setting these on an older tmux prints an error into the
# status line at startup, so ask first.

if -F "#{?#{m:3.[3-9]*,#{version}},1,#{?#{m:[4-9].*,#{version}},1,0}}" {
  set -g popup-style "fg=@FG@,bg=@BG_ELEV@"
  set -g popup-border-style "fg=@LINE@"
  set -g menu-style "fg=@FG@,bg=@BG_ELEV@"
  set -g menu-selected-style "fg=@ON_ACCENT@,bg=@ACCENT@,bold"
  set -g menu-border-style "fg=@LINE@"
}

if -F "#{?#{m:3.[4-9]*,#{version}},1,#{?#{m:[4-9].*,#{version}},1,0}}" {
  set -g popup-border-lines rounded
  set -g menu-border-lines rounded
}
