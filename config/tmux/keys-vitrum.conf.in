# ============================================================================
#  vitrum — tmux keys (vitrum's). Sourced by tmux.conf; yours to edit.
#  The keybind sheet (Super+/) lists them from keys-vitrum.json.
# ============================================================================

# Ctrl+a, not Ctrl+b.
unbind C-b
set -g prefix C-a
bind C-a send-prefix

# vi in copy-mode; y copies to the Wayland clipboard.
setw -g mode-keys vi
bind -T copy-mode-vi q send-keys -X cancel
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi C-v send -X rectangle-toggle
bind -T copy-mode-vi y send -X copy-pipe-and-cancel "wl-copy"
bind -T copy-mode-vi Escape send -X cancel

# Splits keep the current directory.
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind c new-window -c "#{pane_current_path}"

# Reload.
bind r source-file @CONFIG_HOME@/tmux/tmux.conf \; display "\uf021  Config reloaded"

# Resize with the prefix held (repeatable).
bind -r H resize-pane -L 3
bind -r J resize-pane -D 3
bind -r K resize-pane -U 3
bind -r L resize-pane -R 3

# Zoom the pane.
bind f resize-pane -Z
