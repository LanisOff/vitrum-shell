# ============================================================================
#  vitrum — shortcuts
# ============================================================================
#
#  Two rules here, both learned the hard way:
#
#  1. Nothing shadows a standard command. An earlier version of this file
#     abbreviated `ls`, `cat`, `du`, `df`, `ip` and `vi`. fish expands an
#     abbreviation in place, so typing `ls` replaced what you typed with
#     `eza --icons --group-directories-first` in front of you — and if eza was
#     not installed, with a command that did not exist. Surprising at best,
#     broken at worst. Your commands stay your commands.
#
#  2. Anything depending on a tool checks for it first and falls back to the
#     one every machine has.
#
#  The modern replacements are still here under names that are not already
#  taken: `ll`, `la`, `lt`, `cot`. Those are functions, not abbreviations, so
#  what you type stays what you typed.
#
#  This file is replaced on update. Personal shortcuts go in
#  conf.d/99-local.fish, which is never touched.
# ============================================================================

status is-interactive; or exit 0

# Undo the shadowing set that earlier versions installed. Harmless when there
# is nothing to erase, and necessary on fish builds that stored them
# universally, where deleting this file alone would not have been enough.
for _stale in ls cat du df free ip vi ps_ jc jcu t
    abbr --erase $_stale 2>/dev/null
end
set -e _stale

# ------------------------------------------------------------------- git ----
#
# `g` is not a command on any normal system, and the rest are prefixed by it.
abbr -a g      git
abbr -a gs     git status --short --branch
abbr -a ga     git add
abbr -a gaa    git add --all
abbr -a gc     git commit -v
abbr -a gca    git commit -v --amend
abbr -a gco    git checkout
abbr -a gsw    git switch
abbr -a gb     git branch
abbr -a gd     git diff
abbr -a gds    git diff --staged
abbr -a gl     git log --oneline --graph --decorate -20
abbr -a gll    git log --oneline --graph --decorate --all
abbr -a gp     git push
abbr -a gpl    git pull --rebase
abbr -a gf     git fetch --all --prune
abbr -a gst    git stash
abbr -a gstp   git stash pop
abbr -a grh    git reset --hard
command -q lazygit; and abbr -a lg lazygit

# -------------------------------------------------------------- packages ----
#
# The same verbs for whichever package manager the machine has: install,
# remove, update, search the repositories, query what is installed, orphans.
# The letter in front is the manager's: p pacman, x xbps, d dnf.
if command -q pacman
    abbr -a pi     sudo pacman -S
    abbr -a prm    sudo pacman -Rns
    abbr -a pu     sudo pacman -Syu
    abbr -a pse    pacman -Ss
    abbr -a pq     pacman -Qs
    abbr -a orphan pacman -Qtdq
else if command -q xbps-install
    # Void's xtools has commands called xi and xq; where it is installed they
    # stay its own (rule 1).
    for _a in 'xi sudo xbps-install -S' 'xrm sudo xbps-remove -R' 'xu sudo xbps-install -Su' \
              'xse xbps-query -Rs' 'xq xbps-query -s' 'orphan xbps-query -O'
        set -l _w (string split -m 1 ' ' -- $_a)
        command -q $_w[1]; or abbr -a $_w[1] $_w[2]
    end
    set -e _a
else if command -q dnf
    abbr -a di     sudo dnf install
    abbr -a drm    sudo dnf remove
    abbr -a dup    sudo dnf upgrade      # not du: that is the disk usage command
    abbr -a dse    dnf search
    abbr -a dq     dnf list --installed
    abbr -a orphan dnf repoquery --unneeded
end

# ------------------------------------------------------------------ tmux ----
abbr -a tm     tmux
abbr -a ta     tmux attach -t
abbr -a tn     tmux new -s
abbr -a tls    tmux list-sessions
abbr -a tk     tmux kill-session -t

# ------------------------------------------------------------------ logs ----
#
# The system log: journalctl's under systemd; on Void, socklog's, which
# svlogtail follows (you need to be in the socklog group to read it).
if command -q journalctl
    abbr -a jctl   journalctl -xe
    abbr -a jctlu  journalctl --user -xe
else if command -q svlogtail
    abbr -a jctl   svlogtail
end

# ------------------------------------------------------------- navigation ---
abbr -a ..     cd ..
abbr -a ...    cd ../..
abbr -a ....   cd ../../..

# ------------------------------------------------------------- the desktop --
abbr -a settings   vitrum-settings
abbr -a disks      vitrum-disks
abbr -a about      vitrum-about
abbr -a reshell    'vitrum-shell --restart'
abbr -a theme      vitrum-theme
command -q fastfetch; and abbr -a ff fastfetch

# In kitty (tmux inside kitty too) the logo is text kitty draws as the image
# (unicode placeholders, made by the installer): no ImageMagick needed in
# fastfetch — Gentoo builds it without — and tmux keeps it like any text.
# Not kitty-direct: inside tmux it leaves kitty's escape open, and kitty hangs.
# Elsewhere, a TTY, the config's "auto" stays.
#
# fastfetch prints its lines beside the logo, and a terminal too narrow for
# both (half the screen, a tmux split) gets a smaller logo or none, so the
# values keep about 42 columns: the vitrum mark (30 cells and its padding)
# from 90 columns; the distribution's art from 120, its small art from 90.
# Below that, no logo. A line still too long is cut at the edge, never wrapped
# under the logo (config.jsonc: disableLinewrap). A logo of your own (--logo,
# --logo-type, --kitty…) is left exactly as you gave it.
if command -q fastfetch
    function fastfetch --wraps fastfetch --description 'fastfetch, its logo fitted to the terminal'
        if string match -qr -- '^(-l|--logo|--logo-type|--file(-raw)?|--data(-raw)?|--raw|--sixel|--kitty(-direct|-icat)?|--iterm|--chafa)(=.*)?$' $argv
            command fastfetch $argv
            return
        end
        set -l cols $COLUMNS
        test -n "$cols"; or set cols 80
        set -l logo "@VITRUM_STATE@/fastfetch/logo.kitty"
        set -q TMUX; and set logo "@VITRUM_STATE@/fastfetch/logo.tmux"
        if set -q KITTY_WINDOW_ID; and test -s $logo
            if test $cols -ge 90
                command fastfetch --logo $logo --logo-type raw --logo-width 30 --logo-height 15 $argv
            else
                command fastfetch --logo-type none $argv
            end
        else if test $cols -ge 120
            command fastfetch $argv
        else if test $cols -ge 90
            command fastfetch --logo-type small --logo '' $argv
        else
            command fastfetch --logo-type none $argv
        end
    end
end

# -------------------------------------------------------------- listings ----
#
# Functions, not abbreviations: they do not rewrite your input, and they work
# whether or not the prettier tool is installed.

function ll --description "Long listing"
    if command -q eza
        command eza --icons --group-directories-first -l --git $argv
    else
        command ls -lh --color=auto $argv
    end
end

function la --description "Long listing, including dotfiles"
    if command -q eza
        command eza --icons --group-directories-first -la --git $argv
    else
        command ls -lha --color=auto $argv
    end
end

function lt --description "Tree, two levels deep"
    if command -q eza
        command eza --icons --tree --level=2 $argv
    else if command -q tree
        command tree -L 2 $argv
    else
        command ls -R $argv
    end
end

function cot --description "Cat with syntax highlighting, if bat is installed"
    if command -q bat
        command bat --style=plain $argv
    else
        command cat $argv
    end
end
