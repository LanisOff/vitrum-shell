{
  "density": "compact",
  "fonts": {
    "preset": "sans",
    "sans": "Inter",
    "mono": "JetBrains Mono",
    "nerd": "JetBrainsMono Nerd Font",
    "scale": 1
  },
  "materials": {
    "default": "frosted",
    "glassPreset": "lens",
    "groups": {
      "bar": "glass",
      "lock": "glass",
      "launcher": "glass"
    },
    "glassAdvanced": {}
  },
  "palette": {
    "source": "wallpaper",
    "preset": "graphite",
    "accent": ""
  },
  "scheme": {
    "mode": "auto",
    "light": "07:00",
    "dark": "19:30"
  },
  "look": {
    "dichroic": {
      "shift": -100
    }
  },
  "motion": {
    "speed": 1.0,
    "reduce": false
  },
  "bar": {
    "position": "top",
    "primary": "",
    "layout": {
      "left": [
        [
          "workspaces"
        ]
      ],
      "center": [
        [
          "context"
        ]
      ],
      "activities": [
        [
          "recording"
        ],
        [
          "sharing"
        ],
        [
          "timer"
        ],
        [
          "game"
        ],
        [
          "emerge"
        ],
        [
          "shutdown"
        ],
        [
          "vitrum"
        ]
      ],
      "right": [
        [
          "privacy"
        ],
        [
          "cpu",
          "memory",
          "temperature",
          "gpu"
        ],
        [
          "tray",
          "keyboard",
          "network",
          "vpn",
          "bluetooth",
          "phone",
          "volume",
          "microphone",
          "awake",
          "dnd",
          "notifications",
          "updates"
        ]
      ]
    },
    "minimap": false,
    "modules": {
      "context": { "title": true },
      "cpu": { "show": "both" },
      "memory": { "show": "both" },
      "temperature": { "show": "both" },
      "gpu": { "show": "both" },
      "volume": { "percent": false },
      "keyboard": { "long": false }
    }
  },
  "dock": {
    "enabled": true,
    "intellihide": true,
    "magnify": true,
    "magnifyAmount": 1.4,
    "pinned": [
      "kitty",
      "org.kde.dolphin",
      "zen"
    ],
    "iconSize": 44
  },
  "notifications": {
    "position": "top-right",
    "screen": "focused",
    "timeout": 6
  },
  "launcher": {
    "web": "https://www.google.com/search?q=%s"
  },
  "switcher": {
    "quickTapMs": 1000
  },
  "capture": {
    "dir": "~/Pictures/Screenshots",
    "videoDir": "~/Videos/Recordings",
    "copy": true,
    "mode": "area",
    "delay": 0,
    "recorder": "auto",
    "audio": true,
    "fps": 60,
    "ocrLanguages": "eng+rus",
    "thumbnailSeconds": 6,
    "editor": "vitrum",
    "mic": false
  },
  "overview": {
    "overlay": true
  },
  "lock": {
    "dimMinutes": 4,
    "idleMinutes": 5,
    "screenOffMinutes": 10,
    "beforeSleep": true,
    "notifications": "full",
    "ambientSeconds": 10,
    "player": true,
    "power": true
  },
  "sounds": {
    "theme": "/usr/share/sounds/freedesktop/stereo",
    "notification": true,
    "screenshot": true,
    "volume": false,
    "lock": false,
    "device": false,
    "power": false
  },
  "cursor": {
    "theme": "Bibata-Modern-Classic"
  },
  "icons": {
    "theme": "Papirus-Dark"
  },
  "windows": {
    "focus": "shadow",
    "unfocusedOpacity": 0.92,
    "materials": [
      {
        "appId": "kitty",
        "material": "glass"
      }
    ],
    "pipFollows": true
  },
  "terminal": {
    "opacity": 0.72
  },
  "toolkits": {
    "kde": true,
    "gtk": true
  },
  "wallpaper": {
    "path": "",
    "perOutput": {},
    "dir": "~/Pictures/Wallpapers",
    "transition": "grow",
    "parallax": false,
    "live": {
      "enabled": true,
      "pauseWhenCovered": true
    },
    "dayNight": true
  },
  "widgets": {
    "items": [],
    "custom": []
  },
  "weather": {
    "latitude": 0,
    "longitude": 0,
    "place": "",
    "units": "metric"
  },
  "clock": {
    "h24": true,
    "seconds": false
  },
  "awake": {
    "auto": true,
    "media": true
  },
  "games": {
    "mode": true,
    "hud": true,
    "extra": []
  },
  "steam": {
    "theme": {
      "enabled": true,
      "sync": true
    }
  },
  "vesktop": {
    "theme": {
      "enabled": true,
      "sync": true
    }
  },
  "screencast": {
    "remember": {}
  },
  "media": {
    "lyrics": true,
    "lyricsInBar": false,
    "visualizer": true
  },
  "audio": {
    "noiseFilter": false
  },
  "corners": {
    "enabled": true,
    "delay": 150,
    "topLeft": "overview",
    "topRight": "notifications",
    "bottomLeft": "none",
    "bottomRight": "desktop"
  },
  "timers": {
    "work": 25,
    "short": 5,
    "long": 15,
    "rounds": 4
  },
  "picker": {
    "history": []
  },
  "alerts": {
    "enabled": true,
    "gpu": 85,
    "cpu": 90,
    "diskPercent": 90,
    "diskFreeGB": 10,
    "smart": true
  },
  "keyboard": {
    "perApp": true,
    "layouts": []
  },
  "keybinds": { "changes": {}, "own": [] },
  "input": {
    "mouse": { "speed": 0.0, "accel": false, "scroll": 1.0, "natural": false },
    "touchpad": { "speed": 0.25, "natural": true, "tap": true }
  },
  "clipboard": {
    "images": 500
  },
  "updates": {
    "vitrum": {
      "check": true,
      "threshold": 3,
      "hours": 6
    }
  }
}
