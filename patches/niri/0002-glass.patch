diff --git a/src/render_helpers/glass.rs b/src/render_helpers/glass.rs
new file mode 100644
--- /dev/null
+++ b/src/render_helpers/glass.rs
@@ -0,0 +1,65 @@
+//! vitrum's glass: what `shaders/glass.frag` takes.
+//!
+//! A surface with `liquid-glass` in its background effect draws with that shader instead of
+//! `postprocess_and_clip`, on both the xray and the framebuffer path. The shader only ever bends
+//! the view inward, so it samples inside the element and needs no extra capture area.
+
+use niri_config::LiquidGlass;
+use smithay::backend::renderer::gles::{Uniform, UniformName, UniformType};
+
+const FLOATS: [&str; 13] = [
+    "glass_unit",
+    "glass_bend",
+    "glass_edge",
+    "glass_fan",
+    "glass_depth",
+    "glass_rim",
+    "glass_inner_rim",
+    "glass_content",
+    "glass_saturation",
+    "glass_vibrancy",
+    "glass_sheen",
+    "glass_dim",
+    "glass_boost",
+];
+
+/// Names of the shader's own uniforms, for compiling it.
+pub fn uniform_names() -> Vec<UniformName<'static>> {
+    let mut names: Vec<_> = FLOATS
+        .iter()
+        .map(|name| UniformName::new(*name, UniformType::_1f))
+        .collect();
+    names.push(UniformName::new("glass_origin", UniformType::_2f));
+    names.push(UniformName::new("glass_step", UniformType::_2f));
+    names
+}
+
+/// Where a pane is on the output, for the lamp: a position `p` in the element's `geo_size` units
+/// is at `origin + p * step`, in fractions of the output.
+///
+/// Taken at draw time from the rectangle the element really lands on, so that it holds while a
+/// window moves or the overview zooms.
+pub fn push_place(origin: [f32; 2], step: [f32; 2], out: &mut Vec<Uniform<'static>>) {
+    out.push(Uniform::new("glass_origin", origin));
+    out.push(Uniform::new("glass_step", step));
+}
+
+/// `unit` is how many of the element's `geo_size` units make a logical pixel.
+pub fn push_uniforms(glass: &LiquidGlass, unit: f32, out: &mut Vec<Uniform<'static>>) {
+    let values = [
+        unit,
+        glass.refraction_strength as f32,
+        glass.edge_thickness as f32,
+        glass.corner_fan as f32,
+        glass.depth_effect as f32,
+        glass.glow_weight as f32,
+        glass.inner_rim as f32,
+        glass.edge_lighting as f32,
+        glass.saturation as f32,
+        glass.vibrancy as f32,
+        glass.sheen as f32,
+        glass.adaptive_dim as f32,
+        glass.adaptive_boost as f32,
+    ];
+    out.extend(FLOATS.iter().zip(values).map(|(name, v)| Uniform::new(*name, v)));
+}
