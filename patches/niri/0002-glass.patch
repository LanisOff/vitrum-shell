--- /dev/null
+++ b/src/render_helpers/shaders/glass.frag
@@ -0,0 +1,325 @@
+#version 100
+
+//_DEFINES_
+
+#if defined(EXTERNAL)
+#extension GL_OES_EGL_image_external : require
+#endif
+
+precision highp float;
+#if defined(EXTERNAL)
+uniform samplerExternalOES tex;
+#else
+uniform sampler2D tex;
+#endif
+
+uniform float alpha;
+varying vec2 v_coords;
+
+#if defined(DEBUG_FLAGS)
+uniform float tint;
+#endif
+
+uniform float niri_scale;
+
+uniform vec2 geo_size;
+uniform vec4 corner_radius;
+uniform mat3 input_to_geo;
+
+// A frosted slab with a rounded edge lying on what is behind it. The edge bends the
+// view inward. One lamp above the screen lights every pane, so each catches it by
+// where it stands: position and direction come from the lamp, strength and colour
+// from what is behind that spot, alive over bright detail and quiet over dark, with
+// a soft floor so that a pane always has an edge. A rule with an inner rim keeps
+// small pieces as bevelled islands, with two contours, for the bar.
+//
+// Lengths are in geo_size units. glass_unit is how many of those make a logical
+// pixel: xray elements work in zoomed backdrop units.
+uniform float glass_unit;
+uniform float glass_bend;       // refraction-strength: 1 is a quarter of the bevel's width
+uniform float glass_edge;       // edge-thickness
+uniform float glass_fan;        // corner-fan
+uniform float glass_depth;      // depth-effect: the shade on the side away from the lamp
+uniform float glass_rim;        // glow-weight: the rim
+uniform float glass_inner_rim;  // inner-rim: above 0, small pieces stay bevelled islands
+uniform float glass_vibrancy;   // vibrancy
+uniform float glass_sheen;      // sheen: the lamp's soft pool across the face
+uniform float glass_content;    // edge-lighting: the edge's glow, in the backdrop's hue
+uniform float glass_saturation;
+uniform float glass_dim;        // adaptive-dim
+uniform float glass_boost;      // adaptive-boost
+// Where this pane is on the output: a geo position p is at origin + p * step, in
+// fractions of the output.
+uniform vec2 glass_origin;
+uniform vec2 glass_step;
+
+// Index of refraction of the slab, crown glass.
+const float IOR = 1.5;
+// tan(deviation) at the rim, where a ray meets the surface at 90 degrees:
+// sqrt(IOR^2 - 1).
+const float RIM_DEVIATION = 1.118;
+// edge-thickness 1 is a bevel of this many logical pixels. The glass of one
+// surface has one thickness whatever its size, as a pane of glass does.
+const float EDGE_UNIT = 120.0;
+// The islands' light comes from above, a little from the left. y is down.
+const vec2 LIGHT = vec2(-0.447, -0.894);
+// The lamp over a 1080p frame, above the top edge, left of the middle. Height makes
+// it fall off across the screen, and a pane to its right is lit from the left.
+const vec3 LAMP = vec3(600.0, -480.0, 560.0);
+const vec2 FRAME = vec2(1920.0, 1080.0);
+// What a bar island bends by, whatever the rule says for the panels beside it.
+const float ISLAND_BEND = 6.0;
+
+vec4 postprocess(vec4 color);
+
+// The outline at this pixel. g_sil is the distance to the silhouette (the
+// clip), g_opt the distance to the rounder outline the bevel follows, both
+// negative inside. g_out is that outline's outward normal, g_half half of the
+// local short side, g_bevel the bevel's local width.
+float g_sil;
+float g_opt;
+vec2 g_out;
+float g_half;
+float g_bevel;
+// Position in the piece, -1 to 1 on both axes.
+vec2 g_rel;
+
+// A thick slab stays thick on a small piece, but the bevel never eats the face.
+float bevelWidth(float half_side) {
+    return max(min(glass_edge * EDGE_UNIT * glass_unit, 0.5 * half_side), 0.5);
+}
+
+// The corner radius of the bevel's outline. Past the corner radius the distance
+// field has a crease along the diagonal; a corner rounder than the bevel is
+// wide keeps it out of the bevel, and the inner rim stays rounded.
+float opticRadius(float radius, float bevel, float half_side) {
+    return clamp(max(radius, bevel) * glass_fan, radius, half_side);
+}
+
+// Signed distance to a rounded box, q = abs(p - center) - half_size.
+float boxDist(vec2 q, float r) {
+    vec2 k = q + r;
+    return min(max(k.x, k.y), 0.0) + length(max(k, 0.0)) - r;
+}
+
+// Its gradient, rel = p - center.
+vec2 boxNormal(vec2 q, float r, vec2 rel) {
+    vec2 k = q + r;
+    vec2 n;
+    if (k.x > 0.0 && k.y > 0.0)
+        n = normalize(k);
+    else
+        n = k.x > k.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
+    return n * vec2(rel.x < 0.0 ? -1.0 : 1.0, rel.y < 0.0 ? -1.0 : 1.0);
+}
+
+void roundedOutline(vec2 p) {
+    vec2 half_size = geo_size * 0.5;
+    vec2 rel = p - half_size;
+    vec2 q = abs(rel) - half_size;
+    // Top left, top right, bottom right, bottom left.
+    float r = rel.x < 0.0 ? (rel.y < 0.0 ? corner_radius.x : corner_radius.w)
+                          : (rel.y < 0.0 ? corner_radius.y : corner_radius.z);
+
+    g_half = min(half_size.x, half_size.y);
+    g_bevel = bevelWidth(g_half);
+    float optic = opticRadius(r, g_bevel, g_half);
+    g_sil = boxDist(q, r);
+    g_opt = boxDist(q, optic);
+    g_out = boxNormal(q, optic, rel);
+    g_rel = rel / half_size;
+}
+
+// Geo units to a step in v_coords: the inverse of input_to_geo's linear part,
+// so that it holds on rotated outputs too.
+vec2 geoToTex(vec2 step_geo) {
+    vec2 c0 = input_to_geo[0].xy;
+    vec2 c1 = input_to_geo[1].xy;
+    float det = c0.x * c1.y - c1.x * c0.y;
+    vec2 g = step_geo / geo_size;
+    return vec2(c1.y * g.x - c1.x * g.y, c0.x * g.y - c0.y * g.x) / det;
+}
+
+// How far (geo units) the bevel moves the view at 1 - e of the way in. e is
+// the sine of the surface's tilt on a rounded edge. A ray straight down bends
+// by Snell's law and travels through as much glass as there is above the back
+// plane; the result is 1 at the rim and falls to 0 at the flat top.
+float edgeBend(float e) {
+    float cos_a = sqrt(1.0 - e * e);
+    float sin_b = e / IOR;
+    float cos_b = sqrt(1.0 - sin_b * sin_b);
+    float deviation = (e * cos_b - cos_a * sin_b) / (cos_a * cos_b + e * sin_b);
+    return (1.0 + cos_a) * deviation / RIM_DEVIATION;
+}
+
+// The same, eased in, so that nothing marks the place where the bevel ends.
+float bevelBend(float e) {
+    return edgeBend(e) * e * e * (3.0 - 2.0 * e);
+}
+
+vec4 sampleBent(float bend) {
+    if (bend <= 0.0)
+        return texture2D(tex, v_coords);
+
+    // One sample, for all three channels: no chromatic split. On a sharp backdrop
+    // it reads as a rainbow along the edge.
+    return texture2D(tex, clamp(v_coords + geoToTex(-g_out * bend), 0.0, 1.0));
+}
+
+vec3 frost(vec3 color) {
+    const vec3 w = vec3(0.2126, 0.7152, 0.0722);
+    float lum = dot(color, w);
+    float top = max(color.r, max(color.g, color.b));
+    float chroma = top - min(color.r, min(color.g, color.b));
+
+    // Vibrance: muted colours gain more than saturated ones, so the backdrop comes
+    // alive without anything turning neon.
+    float saturate_by = glass_saturation * (1.0 + glass_vibrancy * (1.0 - chroma));
+    color = clamp(mix(vec3(lum), color, saturate_by), 0.0, 1.0);
+
+    float keep = max(1.0 - glass_dim, 0.05);
+    float lift = 1.0 / (keep * keep * keep) - 1.0;
+    color /= pow(1.0 + lift * lum * lum * lum, 1.0 / 3.0);
+
+    return mix(color, vec3(1.0), glass_boost * 0.15);
+}
+
+// The light on the bevel and on its two rims. All of it is white: state and
+// colour belong to the client.
+vec3 islandLight(vec3 color, float e, float depth) {
+    // 1 on an edge that faces the light, -1 on the far one.
+    float facing = dot(g_out, LIGHT);
+    float away = max(-facing, 0.0);
+    float lit = max(facing, 0.0);
+
+    // The surface tilts toward the light on one side, away from it on the other.
+    float tilt = e * facing;
+    color += 1.0 * 0.11 * max(tilt, 0.0);
+    color *= 1.0 - 1.0 * 0.20 * max(-tilt, 0.0);
+
+    // What the lit side lets in comes out on the far side, past the bevel.
+    float past = (depth - g_bevel * 0.8) / (g_bevel * 0.55);
+    color += 1.0 * 0.09 * away * exp(-past * past);
+
+    // The bevel can throw the colour behind it back up. Off by default: on a
+    // sharp backdrop it reads as a coloured line along the rim.
+    color += color * 0.0 * 0.30 * e * e;
+
+    // The rim: thin and bright, brightest where it faces the light.
+    float width = 1.2 * glass_unit;
+    float rim = clamp(1.0 - (-g_sil) / width, 0.0, 1.0);
+    float rim_light = mix(0.28, 1.0, facing * facing);
+    color = mix(color, vec3(1.0), min(rim * rim_light * glass_rim * 0.62, 1.0));
+    // Its shadow keeps it apart from a bright backdrop.
+    float under = (-g_sil - 2.4 * glass_unit) / (1.3 * glass_unit);
+    color *= 1.0 - min(glass_rim, 1.0) * 0.10 * exp(-under * under);
+
+    // The inner rim, where the bevel ends: not a second stroke but light that
+    // went through the slab and leaves it on the far side, a little on the lit
+    // one, nothing along the sides. A thin line in a wider glow.
+    float at = (depth - g_bevel) / (1.0 * glass_unit);
+    float glow_at = (depth - g_bevel) / (5.0 * glass_unit);
+    float along = 0.03 + 0.27 * away * away + 0.12 * lit * lit;
+    float inner = exp(-at * at) + 0.22 * exp(-glow_at * glow_at);
+    // A small piece has no room for it: two contours close together read as a
+    // frame inside a frame.
+    float room = clamp(g_half / (6.0 * g_bevel), 0.2, 1.0);
+    along *= room * sqrt(room);
+    color = mix(color, vec3(1.0), min(inner * along * glass_inner_rim, 1.0));
+
+    return color;
+}
+
+// The lamp on the pane. Colour comes from one sample of the backdrop, so one hue at
+// a spot and no spectral split. State and colour belong to the client.
+vec3 light(vec3 color, vec3 behind, vec2 p) {
+    const vec3 w = vec3(0.2126, 0.7152, 0.0722);
+    float inside = max(-g_sil, 0.0);
+
+    vec3 to_lamp = LAMP - vec3((glass_origin + p * glass_step) * FRAME, 0.0);
+    float dist = length(to_lamp);
+    float near = 1.0 / (1.0 + dist * dist / 1000000.0);
+    vec2 side = normalize(to_lamp.xy);
+    float facing = dot(g_out, side);
+
+    // The lamp's soft pool: panes near it are a little brighter than panes far off.
+    color += glass_sheen * near * to_lamp.z / dist * (1.0 - color);
+
+    // The edge's reach, by the size of the piece. Past this the light is spent.
+    float reach = clamp(0.22 * g_half, 7.0 * glass_unit, 26.0 * glass_unit);
+    if (inside > 4.0 * reach)
+        return color;
+
+    // What the backdrop gives here: its brightness, and how far it stands out from
+    // what lies further in. The floor keeps an edge on a dark backdrop.
+    vec3 deeper = texture2D(tex, clamp(v_coords + geoToTex(-g_rel * reach * 2.0), 0.0, 1.0)).rgb;
+    float here = dot(behind, w);
+    float give = min(0.22 + 0.5 * smoothstep(0.1, 0.8, here) + 1.6 * max(here - dot(deeper, w), 0.0), 1.25);
+
+    float top = max(max(behind.r, max(behind.g, behind.b)), 0.2);
+    vec3 hue = mix(vec3(1.0), behind / top, 0.7);
+
+    // Toward the lamp the edge lights up; it wraps a little round the sides.
+    float lit = smoothstep(-0.35, 0.95, facing);
+
+    // The soft glow, in the backdrop's hue.
+    float fall = exp(-inside / reach);
+    float glow = glass_content * 0.5 * give * fall * (0.3 + 0.7 * lit);
+    color = 1.0 - (1.0 - color) * (1.0 - min(glow, 1.0) * hue);
+
+    // Away from the lamp the edge falls into shade.
+    color *= 1.0 - glass_depth * 0.14 * max(-facing, 0.0) * fall;
+
+    // The rim: soft, a line with a little light under it.
+    float width = 1.1 * glass_unit;
+    float rim = exp(-(inside * inside) / (width * width)) + 0.25 * exp(-inside / (3.0 * glass_unit));
+    float bright = rim * (0.12 + 0.9 * lit * (0.4 + near)) * give * glass_rim;
+    return mix(color, mix(hue, vec3(1.0), 0.55), min(bright, 1.0));
+}
+
+void main() {
+    vec2 uv = (input_to_geo * vec3(v_coords, 1.0)).xy;
+    vec4 color = vec4(0.0);
+
+    if (0.0 <= uv.x && uv.x <= 1.0 && 0.0 <= uv.y && uv.y <= 1.0) {
+        vec2 p = uv * geo_size;
+        roundedOutline(p);
+
+        float cover = clamp(0.5 - g_sil * niri_scale, 0.0, 1.0);
+        if (cover > 0.0) {
+            float depth = max(-g_opt, 0.0);
+            // 1 at the rim, 0 on the flat top.
+            float e = 1.0 - min(depth / g_bevel, 1.0);
+
+            // A rule with an inner rim keeps small pieces as they were: on the bar's
+            // surface the islands and the panels share one rule, so size tells them apart.
+            float island = glass_inner_rim > 0.0
+                ? 1.0 - smoothstep(30.0 * glass_unit, 70.0 * glass_unit, g_half) : 0.0;
+            float bend = 0.0;
+            if (e > 0.0)
+                bend = min(mix(glass_bend, ISLAND_BEND, island) * 0.25 * g_bevel, 0.9 * g_half)
+                    * mix(bevelBend(e), edgeBend(e), island);
+
+            color = sampleBent(bend);
+            vec3 behind = color.rgb;
+#if defined(NO_ALPHA)
+            color.a = 1.0;
+#endif
+            color.rgb = frost(color.rgb);
+            vec3 lit = light(color.rgb, behind, p);
+            if (island > 0.0)
+                lit = mix(lit, islandLight(color.rgb, e, depth), island);
+            color.rgb = lit;
+            color = postprocess(color) * cover;
+        }
+    }
+
+    color = color * alpha;
+
+#if defined(DEBUG_FLAGS)
+    if (tint == 1.0)
+        color = vec4(0.0, 0.2, 0.0, 0.2) + color * 0.8;
+#endif
+
+    gl_FragColor = color;
+}
