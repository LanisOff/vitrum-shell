+impl BlurOptions {
+    /// The same blur, `amount` as wide, on as few textures as that takes.
+    ///
+    /// The width of this blur goes as `offset * 2^passes`. A pass is a texture at half the size
+    /// of the last one, so passes are spent only where offset alone would go past what is
+    /// configured.
+    pub fn scaled(self, amount: f64) -> Self {
+        let width = self.offset * 2f64.powi(i32::from(self.passes)) * amount;
+        let mut passes = 1;
+        while passes < self.passes && width / 2f64.powi(i32::from(passes)) > self.offset {
+            passes += 1;
+        }
+        Self {
+            passes,
+            offset: width / 2f64.powi(i32::from(passes)),
+        }
+    }
+}
+
 #[derive(Debug, Clone)]
