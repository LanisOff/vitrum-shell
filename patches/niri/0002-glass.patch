+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn scaled_blur_takes_fewer_passes_and_keeps_its_width() {
+        let blur = BlurOptions {
+            passes: 3,
+            offset: 3.,
+        };
+
+        let full = blur.scaled(1.);
+        assert_eq!(full.passes, 3);
+        assert!((full.offset - 3.).abs() < 1e-9);
+
+        let half = blur.scaled(0.5);
+        assert_eq!(half.passes, 2);
+        assert!((half.offset - 3.).abs() < 1e-9);
+
+        let light = blur.scaled(0.15);
+        assert_eq!(light.passes, 1);
+        assert!((light.offset - 1.8).abs() < 1e-9);
+    }
+}
