+
+impl GlassShapes {
+    /// Relative to `origin` (the clip geometry's corner), scaled by `zoom`.
+    pub fn uniforms(&self, origin: Point<f64, Logical>, zoom: f64) -> ShapeUniforms {
+        ShapeUniforms {
+            rects: self
+                .shapes
+                .iter()
+                .map(|s| {
+                    let loc = (s.rect.loc - origin).upscale(zoom);
+                    let size = s.rect.size.upscale(zoom);
+                    [loc.x as f32, loc.y as f32, size.w as f32, size.h as f32]
+                })
+                .collect(),
+            meta: self
+                .shapes
+                .iter()
+                .map(|s| [(s.radius * zoom) as f32, s.component as f32, 0., 0.])
+                .collect(),
+            fillet: (self.fillet * zoom) as f32,
+        }
+    }
+}
+
+/// x0, y0, x1, y1
+type Edges = (i32, i32, i32, i32);
+
+/// The pieces of a region, and the rects to draw them in.
+type Shaped = (Vec<Piece>, Arc<Vec<Rectangle<i32, Logical>>>);
+
+/// A piece of glass in surface-local coordinates.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct Piece {
+    pub edges: Edges,
+    pub radius: f64,
+    pub component: u32,
+}
+
+/// Rebuilds the rectangles a client made its blur region from.
+///
+/// Returns the pieces, sorted by component, and the rects the effect should be drawn in: the
+/// fillets lie outside the region itself.
+///
+/// A wl_region arrives as y-banded spans, so one rectangle can come in as several pieces stacked
+/// on top of each other: those are joined back first. Pieces that touch form one component. Where
+/// a narrower piece sits on a wider one it is pushed into it, so the seam between them is interior,
+/// not a rim. A region drawn with rounded corners comes as dozens of scanlines; that is more than
+/// `MAX_SHAPES` and falls back.
+pub fn glass_shapes(
+    rects: &[Rectangle<i32, Logical>],
+    max_radius: f64,
+) -> Option<Shaped> {
+    if rects.is_empty() || rects.len() > 4 * MAX_SHAPES {
+        return None;
+    }
+    let mut v: Vec<Edges> = rects
+        .iter()
+        .filter(|r| r.size.w > 0 && r.size.h > 0)
+        .map(|r| {
+            let c = |v: i32| v.clamp(-MAX_COORD, MAX_COORD);
+            (
+                c(r.loc.x),
+                c(r.loc.y),
+                c(r.loc.x.saturating_add(r.size.w)),
+                c(r.loc.y.saturating_add(r.size.h)),
+            )
+        })
+        .filter(|e| e.0 < e.2 && e.1 < e.3)
+        .collect();
+
+    // Join pieces split by banding: same x-range, stacked edge to edge.
+    while let Some((i, j)) = (0..v.len())
+        .flat_map(|i| (0..v.len()).map(move |j| (i, j)))
+        .find(|&(i, j)| i != j && v[i].0 == v[j].0 && v[i].2 == v[j].2 && v[i].3 == v[j].1)
+    {
+        v[i].3 = v[j].3;
+        v.remove(j);
+    }
+    if v.is_empty() || v.len() > MAX_SHAPES {
+        return None;
+    }
+
+    let overlap = |a: Edges, b: Edges| (a.2.min(b.2) - a.0.max(b.0), a.3.min(b.3) - a.1.max(b.1));
+
+    // Components: pieces that touch along an edge, or overlap.
+    fn root(comp: &mut [usize], mut i: usize) -> usize {
+        while comp[i] != i {
+            comp[i] = comp[comp[i]];
+            i = comp[i];
+        }
+        i
+    }
+    let mut comp: Vec<usize> = (0..v.len()).collect();
+    for i in 0..v.len() {
+        for j in i + 1..v.len() {
+            let (ox, oy) = overlap(v[i], v[j]);
+            if (ox > 0 && oy >= 0) || (oy > 0 && ox >= 0) {
+                let (ri, rj) = (root(&mut comp, i), root(&mut comp, j));
+                comp[ri] = rj;
+            }
+        }
+    }
+
+    // Radii from the pieces as drawn, before any is pushed into its neighbour.
+    let radius: Vec<f64> = v
+        .iter()
+        .map(|r| {
+            let half = f64::from((r.2 - r.0).min(r.3 - r.1)) / 2.;
+            max_radius.min(half).max(0.)
+        })
+        .collect();
+
+    // Push the narrower of two pieces sharing an edge into the wider one.
+    let orig = v.clone();
+    for i in 0..orig.len() {
+        for j in 0..orig.len() {
+            let (a, b) = (orig[i], orig[j]);
+            if i == j {
+                continue;
+            }
+            let within_x = a.0 >= b.0 && a.2 <= b.2 && (a.2 - a.0) < (b.2 - b.0);
+            let within_y = a.1 >= b.1 && a.3 <= b.3 && (a.3 - a.1) < (b.3 - b.1);
+            let reach_x = (b.2 - b.0).min(64);
+            let reach_y = (b.3 - b.1).min(64);
+            if within_x && a.3 == b.1 {
+                v[i].3 = v[i].3.max(a.3 + reach_y);
+            }
+            if within_x && a.1 == b.3 {
+                v[i].1 = v[i].1.min(a.1 - reach_y);
+            }
+            if within_y && a.2 == b.0 {
+                v[i].2 = v[i].2.max(a.2 + reach_x);
+            }
+            if within_y && a.0 == b.2 {
+                v[i].0 = v[i].0.min(a.0 - reach_x);
+            }
+        }
+    }
+
+    let mut pieces: Vec<Piece> = (0..v.len())
+        .map(|i| Piece {
+            edges: v[i],
+            radius: radius[i],
+            component: root(&mut comp, i) as u32,
+        })
+        .collect();
+    pieces.sort_by_key(|p| p.component);
+
+    // Where to draw: a lone piece is its own rect, a melted component needs its whole bounding box
+    // (the fillets sit outside the pieces). Overlapping boxes are joined, so that no pixel is drawn
+    // twice. Pushing a piece into its neighbour never grows the box.
+    let mut boxes: Vec<Edges> = Vec::new();
+    for chunk in pieces.chunk_by(|a, b| a.component == b.component) {
+        boxes.push(chunk.iter().fold(
+            (i32::MAX, i32::MAX, i32::MIN, i32::MIN),
+            |b, p| {
+                let e = p.edges;
+                (b.0.min(e.0), b.1.min(e.1), b.2.max(e.2), b.3.max(e.3))
+            },
+        ));
+    }
+    while let Some((i, j)) = (0..boxes.len())
+        .flat_map(|i| (i + 1..boxes.len()).map(move |j| (i, j)))
+        .find(|&(i, j)| {
+            let (ox, oy) = overlap(boxes[i], boxes[j]);
+            ox > 0 && oy > 0
+        })
+    {
+        let (a, b) = (boxes[i], boxes.remove(j));
+        boxes[i] = (a.0.min(b.0), a.1.min(b.1), a.2.max(b.2), a.3.max(b.3));
+    }
+
+    let boxes = boxes
+        .into_iter()
+        .map(|b| Rectangle::new(Point::new(b.0, b.1), Size::from((b.2 - b.0, b.3 - b.1))))
+        .collect();
+
+    Some((pieces, Arc::new(boxes)))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn rect(x: i32, y: i32, w: i32, h: i32) -> Rectangle<i32, Logical> {
+        Rectangle::new(Point::new(x, y), Size::from((w, h)))
+    }
+
+    #[test]
+    fn separate_islands_stay_apart() {
+        let (pieces, boxes) = glass_shapes(&[rect(0, 0, 100, 32), rect(200, 0, 50, 32)], 10.).unwrap();
+        assert_eq!(pieces.len(), 2);
+        assert_ne!(pieces[0].component, pieces[1].component);
+        assert_eq!(boxes.len(), 2);
+    }
+
+    #[test]
+    fn bands_of_one_rectangle_join() {
+        let (pieces, _) = glass_shapes(&[rect(0, 0, 100, 10), rect(0, 10, 100, 22)], 10.).unwrap();
+        assert_eq!(pieces.len(), 1);
+        assert_eq!(pieces[0].edges, (0, 0, 100, 32));
+    }
+
+    #[test]
+    fn a_neck_melts_into_the_panel_under_it() {
+        let (pieces, boxes) =
+            glass_shapes(&[rect(100, 0, 60, 32), rect(0, 32, 300, 200)], 10.).unwrap();
+        assert_eq!(pieces[0].component, pieces[1].component);
+        // The narrower piece reaches into the wider one, the box stays the union.
+        assert_eq!(boxes.len(), 1);
+        assert_eq!(boxes[0], rect(0, 0, 300, 232));
+        assert!(pieces.iter().any(|p| p.edges == (100, 0, 160, 96)));
+    }
+
+    #[test]
+    fn a_position_past_i32_does_not_overflow() {
+        // What Quickshell sends for x = 1e12, beside an island further right than the item is wide.
+        let (pieces, _) =
+            glass_shapes(&[rect(i32::MIN, 8, 100, 34), rect(1000, 8, 270, 34)], 10.).unwrap();
+        assert_eq!(pieces.len(), 1);
+        assert_eq!(pieces[0].edges, (1000, 8, 1270, 42));
+    }
+
+    #[test]
+    fn extreme_regions_do_not_overflow() {
+        // All of it past the limit: nothing left, the region stays as it came.
+        assert!(glass_shapes(&[rect(i32::MIN, i32::MIN, 100, 100)], 10.).is_none());
+        glass_shapes(&[rect(0, 0, i32::MAX, i32::MAX)], 10.).unwrap();
+        // Two bands whose sum is past i32.
+        glass_shapes(&[rect(0, i32::MIN, 10, i32::MAX), rect(0, -1, 10, i32::MAX)], 10.);
+    }
+
+    #[test]
+    fn scanlines_fall_back() {
+        let rects: Vec<_> = (0..80).map(|y| rect(y, y, 200 - 2 * y, 1)).collect();
+        assert!(glass_shapes(&rects, 10.).is_none());
+    }
 }
