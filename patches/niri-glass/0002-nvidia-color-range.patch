 const DRM_MODE_COLORIMETRY_DEFAULT: u64 = 0;
 
+/// The RGB range of the signal, as the monitor expects it.
+///
+/// NVIDIA's driver takes the planes' COLOR_RANGE (which KMS defines for YCbCr
+/// planes only) as the range of the whole output, and left alone it sends
+/// limited range (16-235) on every mode. A sink reads the CTA video formats
+/// (VICs: 1080p60, 1080p120, ...) on HDMI as limited and everything else (a
+/// 1080p240 monitor mode, DisplayPort) as full, so those came out with grey
+/// blacks and dim whites. Other drivers ignore COLOR_RANGE on RGB planes.
+fn set_color_range(drm: &DrmDevice, crtc: crtc::Handle, conn: connector::Handle, mode: &DrmMode) {
+    use smithay::reexports::drm::Device as _;
+
+    let nvidia = drm
+        .get_driver()
+        .is_ok_and(|d| d.name().to_string_lossy().starts_with("nvidia"));
+    if !nvidia {
+        return;
+    }
+    let hdmi = drm.get_connector(conn, false).is_ok_and(|c| {
+        matches!(
+            c.interface(),
+            connector::Interface::HDMIA | connector::Interface::HDMIB
+        )
+    });
+    let full = !(hdmi && is_cta_video_mode(mode));
+    let want = if full {
+        "YCbCr full range"
+    } else {
+        "YCbCr limited range"
+    };
+
+    let planes = match drm.planes(&crtc) {
+        Ok(planes) => planes,
+        Err(err) => {
+            debug!("couldn't get planes to set COLOR_RANGE: {err:?}");
+            return;
+        }
+    };
+    let all = planes.primary.iter().chain(&planes.overlay).chain(&planes.cursor);
+    for plane in all {
+        let Ok(props) = drm.get_properties(plane.handle) else {
+            continue;
+        };
+        for (prop, _) in props {
+            let Ok(info) = drm.get_property(prop) else {
+                continue;
+            };
+            if info.name().to_str() != Ok("COLOR_RANGE") {
+                continue;
+            }
+            let property::ValueType::Enum(values) = info.value_type() else {
+                continue;
+            };
+            let Some(value) = values
+                .values()
+                .1
+                .iter()
+                .find(|v| v.name().to_str() == Ok(want))
+            else {
+                continue;
+            };
+            match drm.set_property(plane.handle, prop, value.value()) {
+                Ok(()) => debug!("plane {:?}: COLOR_RANGE {want}", plane.handle),
+                Err(err) => debug!("couldn't set COLOR_RANGE: {err:?}"),
+            }
+        }
+    }
+}
