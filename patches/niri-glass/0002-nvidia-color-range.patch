+/// A CTA-861 video format (VIC) by its timing; HDMI sinks take these as
+/// limited range. Rates divided by 1.001 (59.94 Hz and so on) match too.
+fn is_cta_video_mode(mode: &DrmMode) -> bool {
+    // (width, height, htotal, vtotal, pixel clock in kHz, interlaced)
+    const VICS: &[(u16, u16, u16, u16, u32, bool)] = &[
+        (720, 480, 858, 525, 27_000, false),       // 2, 3: 480p60
+        (1280, 720, 1650, 750, 74_250, false),     // 4: 720p60
+        (1920, 1080, 2200, 1125, 74_250, true),    // 5: 1080i60
+        (720, 576, 864, 625, 27_000, false),       // 17, 18: 576p50
+        (1280, 720, 1980, 750, 74_250, false),     // 19: 720p50
+        (1920, 1080, 2640, 1125, 74_250, true),    // 20: 1080i50
+        (1920, 1080, 2200, 1125, 148_500, false),  // 16: 1080p60
+        (1920, 1080, 2640, 1125, 148_500, false),  // 31: 1080p50
+        (1920, 1080, 2750, 1125, 74_250, false),   // 32: 1080p24
+        (1920, 1080, 2640, 1125, 74_250, false),   // 33: 1080p25
+        (1920, 1080, 2200, 1125, 74_250, false),   // 34: 1080p30
+        (1280, 720, 1980, 750, 148_500, false),    // 41: 720p100
+        (1280, 720, 1650, 750, 148_500, false),    // 47: 720p120
+        (1920, 1080, 2200, 1125, 297_000, false),  // 63: 1080p120
+        (1920, 1080, 2640, 1125, 297_000, false),  // 64: 1080p100
+        (3840, 2160, 5500, 2250, 297_000, false),  // 93: 2160p24
+        (3840, 2160, 5280, 2250, 297_000, false),  // 94: 2160p25
+        (3840, 2160, 4400, 2250, 297_000, false),  // 95: 2160p30
+        (3840, 2160, 5280, 2250, 594_000, false),  // 96: 2160p50
+        (3840, 2160, 4400, 2250, 594_000, false),  // 97: 2160p60
+        (4096, 2160, 5500, 2250, 297_000, false),  // 98: 4096x2160p24
+        (4096, 2160, 5280, 2250, 297_000, false),  // 99: 4096x2160p25
+        (4096, 2160, 4400, 2250, 297_000, false),  // 100: 4096x2160p30
+        (4096, 2160, 5280, 2250, 594_000, false),  // 101: 4096x2160p50
+        (4096, 2160, 4400, 2250, 594_000, false),  // 102: 4096x2160p60
+        (3840, 2160, 5280, 2250, 1_188_000, false), // 117: 2160p100
+        (3840, 2160, 4400, 2250, 1_188_000, false), // 118: 2160p120
+    ];
+    let (w, h) = mode.size();
+    let htotal = mode.hsync().2;
+    let vtotal = mode.vsync().2;
+    let clock = mode.clock();
+    let interlaced = mode.flags().contains(ModeFlags::INTERLACE);
+    VICS.iter().any(|&(vw, vh, ht, vt, c, i)| {
+        vw == w
+            && vh == h
+            && ht == htotal
+            && vt == vtotal
+            && i == interlaced
+            && u64::from(clock.abs_diff(c)) * 1000 <= u64::from(c) * 2
+    })
+}
