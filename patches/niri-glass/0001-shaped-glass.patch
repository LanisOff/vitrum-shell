+            for j in i + 1..boxes.len() {
+                let (ox, oy) = overlap(boxes[i], boxes[j]);
+                if ox > 0 && oy > 0 {
+                    joined = Some((i, j));
+                    break 'boxes;
+                }
+            }
+        }
+        match joined {
+            Some((i, j)) => {
+                let (a, b) = (boxes[i], boxes[j]);
+                boxes[i] = (a.0.min(b.0), a.1.min(b.1), a.2.max(b.2), a.3.max(b.3));
+                boxes.remove(j);
+            }
+            None => break,
+        }
+    }
