#!/usr/bin/env python3
"""Writes shell/lib/symbols.js: the symbols the launcher finds by name
(arrows, maths, currency, Greek, fractions, typography…), from Python's
Unicode database. Run again after changing BLOCKS; the result is committed."""
import json
import unicodedata
from pathlib import Path

BLOCKS = [
    (0x00A1, 0x00BF, "Latin-1"),          # ¡ © ® ° ± µ ¶ · ¿ ½ …
    (0x00D7, 0x00D7, "Maths"), (0x00F7, 0x00F7, "Maths"),
    (0x0391, 0x03C9, "Greek"),
    (0x2010, 0x2027, "Punctuation"),      # dashes, quotes, bullets, ellipsis
    (0x2030, 0x205E, "Punctuation"),
    (0x2070, 0x209C, "Super- and subscripts"),
    (0x20A0, 0x20C0, "Currency"),
    (0x2100, 0x214F, "Letterlike"),       # ℃ № ™ Ω ℮
    (0x2150, 0x218B, "Numbers"),          # ⅓ ⅔ Ⅻ
    (0x2190, 0x21FF, "Arrows"),
    (0x2200, 0x22FF, "Maths"),
    (0x2300, 0x23FF, "Technical"),        # ⌘ ⌥ ⏎ ⌫
    (0x25A0, 0x25FF, "Shapes"),
    (0x2600, 0x26FF, "Signs"),            # ☀ ☎ ♠ ♪ ⚠
    (0x2713, 0x2718, "Signs"),            # ✓ ✗
    (0x27F5, 0x27FF, "Arrows"),
    (0x2B05, 0x2B0D, "Arrows"),
]


def main():
    out, seen = [], set()
    for lo, hi, group in BLOCKS:
        for cp in range(lo, hi + 1):
            ch = chr(cp)
            name = unicodedata.name(ch, "")
            if not name or ch in seen or unicodedata.category(ch) in ("Cc", "Cf", "Zs", "Mn"):
                continue
            seen.add(ch)
            out.append({"char": ch, "name": name.lower(), "group": group, "code": "U+%04X" % cp})
    js = (".pragma library\n// Generated by tools/gen-symbols from Unicode names. Do not edit.\n"
          "var all = " + json.dumps(out, ensure_ascii=False, separators=(",", ":")) + ";\n")
    path = Path(__file__).resolve().parent.parent / "shell/lib/symbols.js"
    path.write_text(js, encoding="utf-8")
    print(f"{len(out)} symbols → {path}")


if __name__ == "__main__":
    main()
